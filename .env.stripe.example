# Frontend Vite env
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Edge Function secrets. Set with:
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# supabase secrets set APP_URL=http://127.0.0.1:5173
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
APP_URL=http://127.0.0.1:5173
SITE_URL=http://127.0.0.1:5173

# Tremendous sandbox reward fulfillment. Set with:
# supabase secrets set TREMENDOUS_API_KEY=...
# supabase secrets set TREMENDOUS_BASE_URL=https://testflight.tremendous.com/api/v2
TREMENDOUS_API_KEY=
TREMENDOUS_BASE_URL=https://testflight.tremendous.com/api/v2
TREMENDOUS_CAMPAIGN_ID=
TREMENDOUS_FUNDING_SOURCE_ID=balance
REQUIRE_REWARD_APPROVAL=true

# Supabase provides these automatically in deployed Edge Functions, but include
# them for local function serving if needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
